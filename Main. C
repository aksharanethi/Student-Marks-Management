
#include <stdio.h>

int main() {
    int marks[3][3];
    int i, j;
    int total, passed;
    float avg;

    // Input marks
    for (i = 0; i < 3; i++) {
        printf("\nEnter marks for Student %d:\n", i + 1);

        for (j = 0; j < 3; j++) {
            do {
                printf("Subject %d (0-100): ", j + 1);
                scanf("%d", &marks[i][j]);

                if (marks[i][j] < 0 || marks[i][j] > 100) {
                    printf("Invalid marks! Try again.\n");
                }
            } while (marks[i][j] < 0 || marks[i][j] > 100);
        }
    }

    // Display results
    
printf("\n--- STUDENT RESULTS ---\n");

printf("%-8s %-10s %-10s %-10s %-8s %-8s %-8s\n",
       "Student", "Subject1", "Subject2", "Subject3",
       "Total", "Average", "Result");

for (i = 0; i < 3; i++) {
    total = 0;
    passed = 1;

    for (j = 0; j < 3; j++) {
        total += marks[i][j];

        if (marks[i][j] < 35) {
            passed = 0;
        }
    }

    avg = total / 3.0;

    printf("%-8d %-10d %-10d %-10d %-8d %-8.2f %-8s\n",
           i + 1, marks[i][0], marks[i][1], marks[i][2],
           total, avg, passed ? "Passed" : "Failed");
}
return 0;
}
 

